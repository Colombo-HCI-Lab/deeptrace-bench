# Copy to .env (git-ignored) and fill in. See docs/cluster.md.

# The shared store: datasets, weights, upstream tarballs, manifests, splits, scores, results.
# On Curnagl, a folder in the project's /work space.
DTB_ROOT=/path/to/shared/deeptrace-bench

# Fast scratch for preprocessed inputs. Leave unset inside SLURM jobs to use $TMPDIR/dtb-cache
# (node-local NVMe); set it on machines without a sensible $TMPDIR.
# DTB_CACHE=/path/to/fast/scratch

# Hugging Face cache and token. Leave HF_HOME out to keep a cache you already have. The token
# is only needed for MLAAD (accept its terms first) and Deepfake-Eval-2024. Never commit a token.
HF_HOME=/path/to/shared/deeptrace-bench/hf
# HF_TOKEN=

# uv on network filesystems: copy instead of hard-linking from the cache.
UV_LINK_MODE=copy

# Don't set DTB_NAMESPACE here: smoke.py, --sample and --smoke set it for the run they start.
