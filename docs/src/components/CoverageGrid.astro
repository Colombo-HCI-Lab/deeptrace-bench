---
// One coverage grid, laid out like the round's dashboard: a column per model of one modality, a
// row per evalset it reads, grouped by role and pairing. Every cell carries both views (AUC and
// estimated GPU time); the toggle in coverage.astro picks one.
import { aucBand, cellState, dur, estimate, fmt, gridGroups, gridModels, int, pct, runs, type Modality } from "../lib/status";

interface Props {
  models: Modality;
  evalsets: Modality[];
}

const { models: modality, evalsets: evMods } = Astro.props;
const cols = gridModels(modality);
const groups = gridGroups(evMods);
const cls = (...c: (string | false)[]) => c.filter(Boolean).join(" ");
// Durations short enough for a cell: 12m, 1.5h, 2.0d.
const short = (s: number) => dur(s).replace(" min", "m").replace(" days", "d").replace(" ", "");
const parityNote = (m: (typeof cols)[number]) =>
  m.parity
    ? `parity on ${m.parity.items} clips of ${m.parity.evalset}, largest difference ${m.parity.max_abs_diff.toExponential(1)}`
    : "no parity check yet";
---

<table class="grid">
  <thead>
    <tr>
      <th class="mh">Evalset</th>
      {
        cols.map((m) => (
          <th class={cls("v", !m.adapter && "off")} title={m.id}>
            <span>{m.name}</span>
          </th>
        ))
      }
    </tr>
    <tr class="marks">
      <th class="mh">adapter, parity</th>
      {
        cols.map((m) => (
          <th class="lad" title={`${m.adapter ? "adapter written" : "no adapter yet"}; ${parityNote(m)}`}>
            {m.adapter ? "●" : "○"}
            {m.parity ? "●" : "○"}
          </th>
        ))
      }
    </tr>
  </thead>
  {
    groups.map((g) => (
      <tbody>
        <tr class="grp">
          <th colspan={cols.length + 1}>{g.label}</th>
        </tr>
        {g.evs.map((e) => (
          <tr>
            <th scope="row" class={cls(e.status !== "ready" && "pending")} title={`${e.id}: ${e.status.replace("_", " ")}`}>
              {e.id}
            </th>
            {cols.map((m) => {
              const state = cellState(m, e);
              const t = m.adapter ? estimate(m, e) : null;
              const time = <span class="t">{t == null ? "" : short(t)}</span>;
              if (state === "na") return <td class="na" title="different kind of input" />;
              if (state === "guard")
                return (
                  <td class={cls("guard", e.status !== "ready" && "pending")} title="refused: trained on this data">
                    ⊘
                  </td>
                );
              if (state === "off") return <td class="off" title="no adapter yet" />;
              if (state === "pending")
                return (
                  <td class="pending" title="waiting for data access">
                    <span class="a" />
                    {time}
                  </td>
                );
              if (state === "empty")
                return (
                  <td
                    class="empty"
                    title={`not scored yet${t == null ? "" : `; about ${dur(t)} of GPU time for ${int(e.size!.items)} clips`}`}
                  >
                    <span class="a">·</span>
                    {time}
                  </td>
                );
              // A star marks a caveat beyond cross-corpus; the title says which.
              const r = runs.get(`${m.id}|${e.id}`)!;
              const b = aucBand(r.auc);
              const flagged = r.flags.some((f) => f !== "cross-corpus");
              const tpr = r.tpr_at_fpr05 == null ? "" : `, TPR at 5% FPR ${fmt(r.tpr_at_fpr05, 2)}`;
              const title = `${m.name} × ${e.id}: AUC ${fmt(r.auc)} [${fmt(r.auc_lo)}, ${fmt(r.auc_hi)}], EER ${pct(r.eer)}${tpr}, ${int(r.n)} clips${r.flags.length ? "; " + r.flags.join(", ") : ""}`;
              return (
                <td class="run" style={`background-color: ${b.bg}; color: ${b.fg}`} title={title}>
                  <span class="a">
                    {fmt(r.auc, 2)}
                    {flagged && "*"}
                  </span>
                  {time}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    ))
  }
</table>
