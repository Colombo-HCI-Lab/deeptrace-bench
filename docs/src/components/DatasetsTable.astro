---
// The Dataset catalog's index: every dataset by role, why it is here, its languages and size,
// what we hold and how many runs scored it. Each name opens its own page.
import { DATASETS, ROLES, ROLE_ABOUT, ROLE_LABEL, datasetHref, datasetRuns, holding } from "../lib/catalog";
import { LANG, MOD } from "../lib/status";

const groups = ROLES.map((role) => ({ role, rows: DATASETS.filter((d) => d.role === role) })).filter((g) => g.rows.length);
const langs = (codes: string[]) => {
  const names = codes.map((l) => LANG[l] || l);
  return names.length > 3 ? `${names.slice(0, 2).join(", ")} and ${names.length - 2} more` : names.join(", ");
};
---

<table class="tbl cat datasets">
  <thead>
    <tr>
      <th>Dataset and why it's here</th><th>Kind</th><th>Languages</th><th>Size</th><th>We hold</th><th class="num">Runs</th>
    </tr>
  </thead>
  <tbody>
    {
      groups.map(({ role, rows }) => (
        <Fragment>
          <tr class="group">
            <td colspan="6">
              {ROLE_LABEL[role]} · {rows.length}
              <span class="about">{ROLE_ABOUT[role]}</span>
            </td>
          </tr>
          {rows.map((d) => {
            const h = holding(d);
            const n = datasetRuns(d).length;
            return (
              <tr>
                <td class="wide">
                  <a class="name" href={datasetHref(d.id)}>
                    {d.name}
                  </a>
                  {d.cut && <span class="flagtag cut">cut candidate</span>}
                  {d.why && <span class="sum">{d.why}</span>}
                </td>
                <td class="nowrap">{MOD[d.modality] || d.modality}</td>
                <td title={d.languages.map((l) => LANG[l] || l).join(", ")}>
                  {d.languages.length ? langs(d.languages) : <span class="dim">·</span>}
                </td>
                <td>{d.scale || <span class="dim">·</span>}</td>
                <td class="nowrap">
                  <span class={`hold ${h.key}`}>{h.label}</span>
                </td>
                <td class="num">{n || <span class="dim">·</span>}</td>
              </tr>
            );
          })}
        </Fragment>
      ))
    }
  </tbody>
</table>
