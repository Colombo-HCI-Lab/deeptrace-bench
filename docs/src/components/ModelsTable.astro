---
// The Model catalog's index: every detector by modality, why it is here, what it trained on, its
// size and parity, and its South Asian runs as dots on an AUC axis. Each name opens its own page.
import { MODALITIES, MODELS, modelHref, southAsianRuns } from "../lib/catalog";
import { MOD, params, type Model } from "../lib/status";
import AucStrip from "./AucStrip.astro";

const groups = MODALITIES.map((mod) => ({ mod, rows: MODELS.filter((m) => m.modality === mod) })).filter((g) => g.rows.length);
const trained = (m: Model) =>
  m.trained_on.length > 3 ? `${m.trained_on.slice(0, 2).join(", ")} and ${m.trained_on.length - 2} more` : m.trained_on.join(", ");
---

<table class="tbl cat models">
  <thead>
    <tr>
      <th>Detector and why it's here</th><th>Trained on</th><th class="num">Params</th><th>Parity</th><th>South Asian AUC</th>
    </tr>
  </thead>
  <tbody>
    {
      groups.map(({ mod, rows }) => (
        <Fragment>
          <tr class="group">
            <td colspan="5">
              {MOD[mod]} · {rows.length}
            </td>
          </tr>
          {rows.map((m) => (
            <tr>
              <td class="wide">
                <a class="name" href={modelHref(m.id)}>
                  {m.name}
                </a>
                {m.paper && <span class="venue">{m.paper.venue || m.paper.year}</span>}
                {m.cut && <span class="flagtag cut">cut candidate</span>}
                {m.why && <span class="sum">{m.why}</span>}
              </td>
              <td title={m.trained_on.join(", ")}>{m.trained_on.length ? trained(m) : <span class="dim">·</span>}</td>
              <td class="num">{m.profile ? params(m.profile.params) : <span class="dim">·</span>}</td>
              <td class="nowrap">
                {m.blocked ? <span class="dim">no weights</span> : m.parity ? "✓ passed" : <span class="dim">pending</span>}
              </td>
              <td class="nowrap">
                <AucStrip runs={southAsianRuns(m.id)} />
              </td>
            </tr>
          ))}
        </Fragment>
      ))
    }
  </tbody>
</table>
