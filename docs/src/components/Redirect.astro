---
// A page that moved: send the reader on, keeping the #anchor they came with. routes sends an
// anchor matching a pattern somewhere else instead.
interface Props {
  to: string;
  title: string;
  routes?: [string, string][];
}

const { to, title, routes = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title} · deeptrace-bench</title>
    <link rel="canonical" href={new URL(to, Astro.site).href} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <script is:inline define:vars={{ to, routes }}>
      const r = routes.find(([re]) => new RegExp(re).test(location.hash));
      location.replace((r ? r[1] : to) + location.hash);
    </script>
  </head>
  <body>
    <p>This page is now at <a href={to}>{to}</a>.</p>
  </body>
</html>
