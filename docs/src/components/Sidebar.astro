---
// The one sidebar every page shares: each doc in its group and order, with the overview and the
// Models & data page slotted in, and the current page opened up to its sections. The guided pages
// for Results, Progress and How it works stand in for their docs (docHref sends them there).
import { getCollection } from "astro:content";
import { GROUPS, docHref } from "../lib/docs";

export interface Section {
  href: string;
  text: string;
}

interface Props {
  // The current page: a doc id, or "home", "inventory" or "docs-index".
  current: string;
  sections?: Section[];
}

const { current, sections = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const extra: Record<string, { key: string; label: string; href: string; after?: string }[]> = {
  start: [{ key: "home", label: "Overview", href: base }],
  findings: [{ key: "inventory", label: "Models & data", href: `${base}inventory/`, after: "results" }],
};
const groups = Object.entries(GROUPS).map(([group, label]) => {
  const items = docs
    .filter((d) => d.data.group === group)
    .map((d) => ({ key: d.id, label: d.data.title.replaceAll("`", ""), href: docHref(d.id) }));
  for (const x of extra[group] ?? []) {
    const at = x.after ? items.findIndex((i) => i.key === x.after) + 1 : 0;
    items.splice(at, 0, x);
  }
  return { label, items };
});
// A section link that points into this page carries the id the scroll tracker watches.
const secId = (href: string) => (href.startsWith("#") ? href.slice(1) : undefined);
---

<div class="side-tree">
  {
    groups.map((g) => (
      <div>
        <div class="kicker">{g.label}</div>
        <ol>
          {g.items.map((i) => (
            <li>
              <a href={i.href} aria-current={i.key === current ? "page" : undefined}>
                {i.label}
              </a>
              {i.key === current && sections.length > 0 && (
                <ol class="secs">
                  {sections.map((s) => (
                    <li>
                      <a href={s.href} data-sec={secId(s.href)}>
                        {s.text}
                      </a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </div>
    ))
  }
  <a class="side-all" href={`${base}docs/`} aria-current={current === "docs-index" ? "page" : undefined}>All docs, with descriptions</a>
</div>
