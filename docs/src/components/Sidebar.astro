---
// The one nav every page shares (lib/nav.ts): each page in its group, subsections under their
// heading, and the docs of the Models and datasets group always open to their sections. The rail
// on wide screens and the menu on narrow ones both render it.
import { railSections, type Section } from "../lib/docs";
import { NAV, RAIL_GROUP, STANDS_IN, href, isLeaf, type Leaf } from "../lib/nav";

interface Props {
  // The current page: a nav id, or a doc a guided page stands in for.
  current: string;
}

const here = STANDS_IN[Astro.props.current] ?? Astro.props.current;
const secs: Record<string, Section[]> = {};
for (const g of NAV.filter((g) => g.label === RAIL_GROUP))
  for (const it of g.items) for (const l of isLeaf(it) ? [it] : it.items) secs[l.id] = await railSections(l.id);
// A section link into this page carries the id the scroll tracker watches.
const link = (l: Leaf) => ({ ...l, href: href(l.id), secs: (secs[l.id] ?? []).length > 1 ? secs[l.id] : [] });
const at = (l: Leaf, s: Section) => (l.id === here ? s.href : href(l.id) + s.href);
---

<div class="tree">
  {
    NAV.map((g) => (
      <div>
        <div class="group">{g.label}</div>
        <ol>
          {g.items.map((it) => {
            const ls = isLeaf(it) ? [link(it)] : it.items.map(link);
            const list = ls.map((l) => (
              <li>
                <a href={l.href} aria-current={l.id === here ? "page" : undefined}>
                  {l.label}
                </a>
                {l.secs.length > 0 && (
                  <ol class="secs" aria-label="On this page">
                    {l.secs.map((s) => (
                      <li>
                        <a href={at(l, s)} data-sec={l.id === here ? s.href.slice(1) : undefined}>
                          {s.text}
                        </a>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ));
            return isLeaf(it) ? (
              list
            ) : (
              <li>
                <div class="sub">{it.heading}</div>
                <ol>{list}</ol>
              </li>
            );
          })}
        </ol>
      </div>
    ))
  }
</div>
