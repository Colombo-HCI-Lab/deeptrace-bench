---
// What healthy and broken crop thumbnails look like.
import { FG } from "../../lib/figures";
---

<figure class="fig">
            <div style="border: 1px solid var(--rule); background: var(--card); padding: 20px; display: grid; grid-template-columns: repeat(auto-fill, minmax(124px, 1fr)); gap: 20px 18px; min-width: 0">
              {FG.crops.map((c) => (<Fragment>
                <div style="display: grid; gap: 10px; align-content: start; min-width: 0">
                  <div aria-hidden="true" style={`position: relative; width: 100%; max-width: 150px; aspect-ratio: 1; background: var(--rule); overflow: hidden; outline: 1.5px solid ${c.ring}; outline-offset: 3px`}>
                    {c.edge && (<Fragment><span style="position: absolute; left: 0; top: 0; bottom: 0; width: 15%; background: var(--ink)"></span></Fragment>)}
                    <div style={`position: absolute; inset: 0; transform: ${c.tf}`}>
                      <span style="position: absolute; left: 27%; top: 15%; width: 46%; height: 66%; border: 1.5px solid var(--ink); border-radius: 50%; background: var(--tint)"></span>
                      <span style="position: absolute; left: 20%; right: 20%; top: 40%; border-top: 1px dashed var(--muted)"></span>
                      <span style="position: absolute; left: 40%; top: 40%; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); transform: translate(-50%, -50%)"></span>
                      <span style="position: absolute; left: 60%; top: 40%; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); transform: translate(-50%, -50%)"></span>
                      <span style="position: absolute; left: 50%; top: 53%; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); transform: translate(-50%, -50%)"></span>
                      <span style="position: absolute; left: 42%; top: 65%; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); transform: translate(-50%, -50%)"></span>
                      <span style="position: absolute; left: 58%; top: 65%; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); transform: translate(-50%, -50%)"></span>
                    </div>
                  </div>
                  <div style="display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 4px; font-size: 0.85rem; line-height: 1.35"><span style={`font: 600 13px/1.3 var(--mono); color: ${c.ring}`}>{c.mark}</span><span>{c.label}</span></div>
                </div>
              </Fragment>))}
            </div>
            <figcaption><strong>What to look for in the crop thumbnails.</strong> The first two are healthy; the other three mean detection or alignment broke, whatever the scores say. Schematic, not real crops.</figcaption>
          </figure>
