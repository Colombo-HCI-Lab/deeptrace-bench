---
// Every page: fonts, the shared styles, the site bar, the one nav, the previous and next pages
// and the footer.
import Sidebar from "../components/Sidebar.astro";
import "../styles/site.css";
import { pager } from "../lib/nav";
import { D } from "../lib/status";

interface Props {
  title: string;
  description: string;
  // The page's nav id (lib/nav.ts), or the doc it shows.
  current: string;
}

const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const { prev, next } = pager(current);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
  </head>
  <body>
    <header class="site">
      <div class="in">
        <a class="name" href={base}>deeptrace-bench</a>
        <div class="right">
          <a class="gh" href="https://github.com/Colombo-HCI-Lab/deeptrace-bench" target="_blank" rel="noopener">GitHub ↗</a>
          <details class="menu">
            <summary><span class="open">Menu</span><span class="close">Close</span></summary>
            <nav aria-label="Site"><Sidebar current={current} /></nav>
          </details>
        </div>
      </div>
    </header>
    <div class="shell">
      <aside class="side">
        <nav aria-label="Site"><Sidebar current={current} /></nav>
      </aside>
      <main class="wrap">
        <slot />
        <nav class="pager" aria-label="Previous and next page">
          <div>{prev && <a href={prev.href}><span>← Previous</span><span>{prev.label}</span></a>}</div>
          <div>{next && <a class="next" href={next.href}><span>Next →</span><span>{next.label}</span></a>}</div>
        </nav>
        <footer>
          <span>Updated {D.built} · Colombo HCI Lab</span>
          <span>
            Rebuild the data with <code>uv run scripts/build_site.py</code> where DTB_ROOT is set; every push to main
            redeploys the site.
          </span>
          <span><a href={`${base}docs/`}>Every doc</a> · <a href="https://github.com/Colombo-HCI-Lab/deeptrace-bench" target="_blank" rel="noopener">source</a></span>
        </footer>
      </main>
    </div>
    <script is:inline>
      // Mark the section in view in the nav, and close the menu once a link is chosen.
      (() => {
        const links = [...document.querySelectorAll("a[data-sec]")];
        const ids = [...new Set(links.map((a) => a.dataset.sec))];
        const targets = ids.map((id) => document.getElementById(id)).filter(Boolean);
        if (targets.length) {
          let queued = false;
          const mark = () => {
            queued = false;
            let cur = targets[0].id;
            for (const t of targets) if (t.getBoundingClientRect().top < 140) cur = t.id;
            for (const a of links) a.toggleAttribute("data-on", a.dataset.sec === cur);
          };
          addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(mark); } }, { passive: true });
          mark();
        }
        const menu = document.querySelector("details.menu");
        menu?.addEventListener("click", (e) => { if (e.target.closest("nav a")) menu.open = false; });
      })();
    </script>
  </body>
</html>
