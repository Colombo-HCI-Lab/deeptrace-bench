---
// Every page: fonts, the shared styles, the site bar and the footer.
import "../styles/site.css";
import { D } from "../lib/status";

interface Props {
  title: string;
  description: string;
  // Which site-bar link is the current page.
  section: "overview" | "results" | "progress" | "method" | "inventory" | "docs";
}

const { title, description, section } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { id: "overview", label: "Overview", href: base },
  { id: "results", label: "Results", href: `${base}results/` },
  { id: "progress", label: "Progress", href: `${base}progress/` },
  { id: "method", label: "How it works", href: `${base}method/` },
  { id: "inventory", label: "Models & data", href: `${base}inventory/` },
  { id: "docs", label: "Docs", href: `${base}docs/` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
    />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <header class="site">
      <div class="in">
        <a class="name" href={base}>deeptrace-bench</a>
        <nav aria-label="Site">
          <ol>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={n.id === section ? "page" : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
            <li><a href="https://github.com/Colombo-HCI-Lab/deeptrace-bench" target="_blank" rel="noopener">GitHub ↗</a></li>
          </ol>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
      <footer>
        <span>Updated {D.built}.</span>
        <span>
          Rebuild the data with <code>uv run scripts/build_site.py</code> where DTB_ROOT is set; every push to main
          redeploys the site.
        </span>
        <span>Colombo HCI Lab · <a href="https://github.com/Colombo-HCI-Lab/deeptrace-bench" target="_blank" rel="noopener">source</a></span>
      </footer>
    </main>
  </body>
</html>
