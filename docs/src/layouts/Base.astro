---
// Every page: fonts, the shared styles, the site bar, the one sidebar and the footer.
import Sidebar, { type Section } from "../components/Sidebar.astro";
import "../styles/site.css";
import { D } from "../lib/status";

interface Props {
  title: string;
  description: string;
  section: "overview" | "results" | "progress" | "method" | "inventory" | "docs";
  // The doc being shown, for doc pages; the guided pages map from section.
  current?: string;
  // The page's own sections, listed under it in the sidebar.
  sections?: Section[];
}

const { title, description, section, current, sections = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const here =
  current ??
  { overview: "home", results: "results", progress: "progress", method: "method", inventory: "inventory", docs: "docs-index" }[
    section
  ];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <header class="site">
      <div class="in">
        <a class="name" href={base}>deeptrace-bench</a>
        <a class="gh" href="https://github.com/Colombo-HCI-Lab/deeptrace-bench" target="_blank" rel="noopener">GitHub ↗</a>
        <details class="menu">
          <summary>Menu</summary>
          <nav aria-label="Site"><Sidebar current={here} sections={sections} /></nav>
        </details>
      </div>
    </header>
    <div class="shell">
      <nav class="side" aria-label="Site"><Sidebar current={here} sections={sections} /></nav>
    <main class="wrap">
      <slot />
      <footer>
        <span>Updated {D.built}.</span>
        <span>
          Rebuild the data with <code>uv run scripts/build_site.py</code> where DTB_ROOT is set; every push to main
          redeploys the site.
        </span>
        <span>Colombo HCI Lab · <a href="https://github.com/Colombo-HCI-Lab/deeptrace-bench" target="_blank" rel="noopener">source</a></span>
      </footer>
    </main>
    </div>
    <script is:inline>
      // Mark the section in view in the sidebar, and close the phone menu once a link is chosen.
      (() => {
        const links = [...document.querySelectorAll("a[data-sec]")];
        const ids = [...new Set(links.map((a) => a.dataset.sec))];
        const targets = ids.map((id) => document.getElementById(id)).filter(Boolean);
        if (targets.length) {
          let queued = false;
          const mark = () => {
            queued = false;
            let cur = targets[0].id;
            for (const t of targets) if (t.getBoundingClientRect().top < 140) cur = t.id;
            for (const a of links) a.toggleAttribute("data-on", a.dataset.sec === cur);
          };
          addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(mark); } }, { passive: true });
          mark();
        }
        const menu = document.querySelector("details.menu");
        menu?.addEventListener("click", (e) => { if (e.target.closest("a")) menu.open = false; });
      })();
    </script>
  </body>
</html>
