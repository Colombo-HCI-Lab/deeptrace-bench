---
// One doc: its group, title and description, a bar of its sections (unless the nav lists them),
// and the Markdown, with the doc's figures (lib/figures.ts) set between its blocks.
import { getEntry } from "astro:content";
import Crops from "../components/figures/Crops.astro";
import Faces from "../components/figures/Faces.astro";
import Jobs from "../components/figures/Jobs.astro";
import Namespaces from "../components/figures/Namespaces.astro";
import Pairing from "../components/figures/Pairing.astro";
import Parity from "../components/figures/Parity.astro";
import ParityDots from "../components/figures/ParityDots.astro";
import Recipe from "../components/figures/Recipe.astro";
import RunId from "../components/figures/RunId.astro";
import Sampler from "../components/figures/Sampler.astro";
import SmokeFlow from "../components/figures/SmokeFlow.astro";
import Storage from "../components/figures/Storage.astro";
import Threshold from "../components/figures/Threshold.astro";
import Verdicts from "../components/figures/Verdicts.astro";
import Windows from "../components/figures/Windows.astro";
import { docView } from "../lib/docs";
import { FIGS, parityDots, recipe } from "../lib/figures";
import { RAIL_GROUP } from "../lib/nav";
import Base from "./Base.astro";

interface Props {
  slug: string;
}

const base = import.meta.env.BASE_URL;
const v = await docView(Astro.props.slug);
// The Dataset catalog used to be this doc with every entry below it: its old anchors open the
// catalog's own pages now.
const oldEntries = v.slug === "datasets" ? { entry: `${base}dataset-catalog/`, all: `${base}dataset-catalog/` } : null;
// A title may carry a code span, as `DTB_ROOT` does.
const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]!);
const titleHtml = esc(v.title).replace(/`([^`]+)`/g, "<code>$1</code>");
const showSections = v.sections.length > 1 && v.group !== RAIL_GROUP;

// Cut the blocks wherever a figure goes; each piece carries the figures that follow it.
const at = new Map<number, string[]>();
for (const [h, off, key] of FIGS[v.slug] ?? []) {
  const i = h ? v.blocks.findIndex((b) => b.id === h) : -1;
  if (h && i < 0) continue;
  const p = Math.min(v.blocks.length, (h ? i + 1 : 0) + off);
  at.set(p, [...(at.get(p) ?? []), key]);
}
const cuts = [...at.keys()].sort((a, b) => a - b);
let s = 0;
const chunks = [...cuts, v.blocks.length].map((p, j) => {
  const html = v.blocks
    .slice(s, p)
    .map((b) => b.html)
    .join("\n");
  s = p;
  return { html, figs: j < cuts.length ? at.get(p)! : [] };
});
// The figures that need nothing from the doc.
const FIGURE: Record<string, typeof Pairing> = {
  pairing: Pairing,
  windows: Windows,
  faces: Faces,
  threshold: Threshold,
  verdicts: Verdicts,
  runid: RunId,
  namespaces: Namespaces,
  smokeflow: SmokeFlow,
  crops: Crops,
  parity: Parity,
  sampler: Sampler,
  storage: Storage,
  jobs: Jobs,
};
const R = recipe(v.slug, v.sections);
const dots = v.slug === "models" ? parityDots((await getEntry("docs", "models"))!.body ?? "") : [];
---

<Base title={`${v.title.replaceAll("`", "")} · deeptrace-bench`} description={v.description} current={v.slug}>
  <div class="page">
    <header class="mast">
      <div class="kicker">{v.group || "Docs"}</div>
      <h1 set:html={titleHtml} />
      <p class="lede">{v.description}</p>
    </header>
    {
      showSections && (
        <nav class="index" aria-label="On this page">
          <ol>
            {v.sections.map((h) => (
              <li>
                <a href={h.href}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <article class="prose">
      {
        chunks.map((c) => (
          <Fragment>
            <Fragment set:html={c.html} />
            {c.figs.map((k) =>
              k === "recipe" ? (
                R && <Recipe recipe={R} />
              ) : k === "paritydots" ? (
                dots.length > 0 && <ParityDots dots={dots} />
              ) : (
                (() => {
                  const Fig = FIGURE[k];
                  return Fig ? <Fig /> : null;
                })()
              ),
            )}
          </Fragment>
        ))
      }
    </article>
  </div>
  {
    oldEntries && (
      <script is:inline define:vars={oldEntries}>
        const id = location.hash.match(/^#dataset-(.+)$/)?.[1];
        if (id) location.replace(`${entry}${id}/`);
        else if (location.hash === "#all-datasets") location.replace(all);
      </script>
    )
  }
</Base>
