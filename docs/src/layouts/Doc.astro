---
// One doc: its title, a section index from its H2s (in the sidebar, and above the text on narrow
// screens), and the Markdown.
import type { MarkdownHeading } from "astro";
import { GROUPS } from "../lib/docs";
import Base from "./Base.astro";

interface Props {
  id: string;
  title: string;
  description: string;
  group: keyof typeof GROUPS;
  headings: MarkdownHeading[];
}

const { id, title, description, group, headings } = Astro.props;
const sections = headings.filter((h) => h.depth === 2);
// A title may carry a code span, as `DTB_ROOT` does.
const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]!);
const titleHtml = esc(title).replace(/`([^`]+)`/g, "<code>$1</code>");
---

<Base
  title={`${title.replaceAll("`", "")} · deeptrace-bench`}
  description={description}
  section="docs"
  current={id}
  sections={sections.map((h) => ({ href: `#${h.slug}`, text: h.text }))}
>
  <div class="page">
    <header class="mast">
      <div class="kicker">Docs · {GROUPS[group]}</div>
      <h1 set:html={titleHtml} />
      <p class="lede">{description}</p>
    </header>
    {
      sections.length > 1 && (
        <nav class="index" aria-label="Sections">
          <ol>
            {sections.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <article class="prose"><slot /></article>
  </div>
</Base>
