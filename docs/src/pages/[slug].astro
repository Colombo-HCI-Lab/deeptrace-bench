---
// Docs used to live at the site root; they moved under docs/ when the guided pages arrived.
// Results and Progress kept their root URLs as guided pages, so they need no stub.
import { getCollection } from "astro:content";
import Redirect from "../components/Redirect.astro";
import { GUIDED } from "../lib/links.mjs";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.filter((d) => !GUIDED.has(d.id)).map((d) => ({ params: { slug: d.id }, props: { title: d.data.title } }));
}

const { slug } = Astro.params;
---

<Redirect to={`${import.meta.env.BASE_URL}docs/${slug}/`} title={Astro.props.title.replaceAll("`", "")} />
