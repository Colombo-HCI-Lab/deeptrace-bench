---
// Every detector against every evalset, laid out like the round's dashboard: the AUC of each run in
// bands of 0.1, or the estimated single-GPU time for a full one, from src/reference/status.json
// (scripts/build_site.py writes it).
import CoverageGrid from "../components/CoverageGrid.astro";
import Base from "../layouts/Base.astro";
import { AUC_BANDS, cellState, gridGroups, gridModels, int, type CellState, type Modality } from "../lib/status";

// Video first, as on the dashboard; each model only against the kinds of input it reads.
const SECTIONS: [Modality, Modality[], string][] = [
  ["video", ["video", "image"], "Video models"],
  ["audio_video", ["audio_video"], "Audio-visual models"],
  ["audio", ["audio"], "Audio models"],
];
const count: Record<CellState, number> = { run: 0, guard: 0, na: 0, empty: 0, pending: 0, off: 0 };
for (const [mod, evMods] of SECTIONS)
  for (const m of gridModels(mod))
    for (const g of gridGroups(evMods)) for (const e of g.evs) count[cellState(m, e)] += 1;
---

<Base
  title="Coverage · deeptrace-bench"
  description="Every detector against every evalset in deeptrace-bench: the AUC of each run, or the estimated GPU time for a full one."
  current="coverage"
>
  <div class="page">
    <header class="mast">
      <div class="kicker">Models and datasets</div>
      <h1>Coverage</h1>
      <p class="lede">
        Every detector against every evalset it can read: a column per model, a row per evalset, AUC in bands of
        0.1, or the estimated single-GPU time for a full run.
      </p>
    </header>
    <section id="coverage" class="panel" data-mode="auc">
      <div class="tally">
        <div><b>{int(count.run)}</b><span>pairs scored in full</span></div>
        <div><b>{int(count.empty)}</b><span>not scored yet</span></div>
        <div><b>{int(count.guard)}</b><span>refused by the guard</span></div>
        <div><b>{int(count.pending)}</b><span>waiting for data access</span></div>
        <div><b>{int(count.off)}</b><span>waiting for an adapter</span></div>
      </div>
      <div class="toggle" role="group" aria-label="Show in cells">
        <button type="button" data-mode="auc" aria-pressed="true">AUC</button>
        <button type="button" data-mode="time" aria-pressed="false">Estimated GPU time</button>
      </div>
      <div class="legend">
        {AUC_BANDS.map((b) => <span><i class="cell" style={`background: ${b.bg}`} />AUC {b.label}</span>)}
      </div>
      <div class="legend">
        <span><i>*</i>has a caveat (hover)</span>
        <span><i class="guard">⊘</i>refused: trained on this data</span>
        <span><i>·</i>not scored yet</span>
        <span><i class="hatch"></i>waiting for data access</span>
        <span><i class="off"></i>no adapter yet</span>
        <span><i class="na"></i>can't read this kind of input</span>
      </div>
      {
        SECTIONS.map(([mod, evMods, label]) => (
          <>
            <h3>{label}</h3>
            <div class="scroll">
              <CoverageGrid models={mod} evalsets={evMods} />
            </div>
          </>
        ))
      }
      <p class="note">
        Under each model: ● adapter written, then ● parity passed against upstream code; ○ not yet. Italic evalsets
        are waiting for data access. Hover a cell for its numbers. Quick subsets, stratified samples of sets shown in
        full, are left out.
      </p>
    </section>
  </div>
</Base>

<script>
  // AUC or estimated GPU time in the grids. Both are in the page; this only switches.
  const coverage = document.getElementById("coverage")!;
  for (const b of coverage.querySelectorAll<HTMLButtonElement>(".toggle button")) {
    b.addEventListener("click", () => {
      coverage.dataset.mode = b.dataset.mode;
      for (const o of coverage.querySelectorAll(".toggle button")) o.setAttribute("aria-pressed", String(o === b));
    });
  }
</script>
