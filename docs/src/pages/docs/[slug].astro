---
// The docs' addresses until 2026-10-29, when each page kept one address: every doc moved to the
// site root, and the full write-ups of Results, Progress and How it works gave way to their
// guided pages. Each old address forwards to the page that replaced it, with its #anchor.
import { getCollection } from "astro:content";
import Redirect from "../../components/Redirect.astro";
import { MOVED, docPath } from "../../lib/links.mjs";

export async function getStaticPaths() {
  const base = import.meta.env.BASE_URL;
  const docs = await getCollection("docs");
  return [
    ...docs.filter((d) => d.id !== "catalog").map((d) => ({ params: { slug: d.id }, props: { to: base + docPath(d.id), title: d.data.title } })),
    // catalog.md has no page: its old address opens the Model or Dataset catalog by anchor.
    ...docs
      .filter((d) => d.id === "catalog")
      .map(() => ({
        params: { slug: "catalog" },
        props: { to: `${base}model-catalog/`, title: "Model catalog", routes: [["^#(dataset|all-datasets)", `${base}dataset-catalog/`]] },
      })),
    ...Object.entries(MOVED).map(([slug, to]) => ({ params: { slug }, props: { to: base + to, title: "Moved" } })),
  ];
}

const { to, title, routes } = Astro.props;
---

<Redirect to={to} title={title.replaceAll("`", "")} routes={routes} />
