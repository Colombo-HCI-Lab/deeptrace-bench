---
import { getCollection, render } from "astro:content";
import Redirect from "../../components/Redirect.astro";
import Doc from "../../layouts/Doc.astro";
import { MOVED } from "../../lib/links.mjs";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return [
    ...docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } })),
    // Docs merged into others: their old address forwards to the new place.
    ...Object.entries(MOVED).map(([slug, to]) => ({ params: { slug }, props: { moved: to } })),
  ];
}

const { entry, moved } = Astro.props;
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

{
  moved ? (
    <Redirect to={import.meta.env.BASE_URL + moved} title="Moved" />
  ) : (
    <Doc
      id={entry.id}
      title={entry.data.title}
      description={entry.data.description}
      group={entry.data.group}
      headings={rendered!.headings}
    >
      {Content && <Content />}
    </Doc>
  )
}
