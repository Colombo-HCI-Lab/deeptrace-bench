---
import { getCollection } from "astro:content";
import Redirect from "../../components/Redirect.astro";
import Doc from "../../layouts/Doc.astro";
import { MOVED } from "../../lib/links.mjs";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return [
    ...docs.map((entry) => ({ params: { slug: entry.id }, props: { slug: entry.id } })),
    // Docs merged into others: their old address forwards to the new place.
    ...Object.entries(MOVED).map(([slug, to]) => ({ params: { slug }, props: { moved: to } })),
  ];
}

const { slug, moved } = Astro.props;
const base = import.meta.env.BASE_URL;
---

{
  moved ? (
    <Redirect to={base + moved} title="Moved" />
  ) : slug === "catalog" ? (
    // catalog.md is the two catalogs' text for GitHub; on the site each entry has a page of its own.
    <Redirect to={`${base}model-catalog/`} title="Model catalog" routes={[["^#(dataset|all-datasets)", `${base}dataset-catalog/`]]} />
  ) : (
    <Doc slug={slug!} />
  )
}
