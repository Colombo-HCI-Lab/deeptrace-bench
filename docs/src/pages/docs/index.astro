---
// Every page in nav order, with its description: a doc's from its front matter, a guided page's
// from PAGE_ABOUT.
import { getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { NAV, PAGES, href, leaves } from "../../lib/nav";

const PAGE_ABOUT: Record<string, string> = {
  timeline: "Where things stand, what each round of work did, and what comes next",
  results: "What the runs show, with the numbers and their caveats",
  method: "The pipeline, the checks along it and the terms the site uses",
  coverage: "Every detector against every evalset: AUC, or the estimated GPU time",
  compute: "What each detector costs to run",
  "model-catalog": "Every detector: why it's here, parity and its South Asian results, with a page per model",
  "dataset-catalog": "Every dataset: why it's here, what we hold and the languages it covers, with a page per dataset",
};
const groups = await Promise.all(
  NAV.map(async (g) => ({
    label: g.label,
    rows: await Promise.all(
      leaves(g.items).map(async (l) => ({
        label: l.label,
        href: href(l.id),
        about: PAGES.includes(l.id) ? PAGE_ABOUT[l.id] : ((await getEntry("docs", l.id))?.data.description ?? ""),
      })),
    ),
  })),
);
---

<Base title="Every doc · deeptrace-bench" description="Every page and doc, by group, with what each covers." current="docs">
  <div class="page">
    <header class="mast">
      <div class="kicker">Docs</div>
      <h1>Every doc</h1>
      <p class="lede">
        New here? Start with <a href={href("method")}>How it works</a>, then <a href={href("getting_started")}>Getting started</a>.
      </p>
    </header>
    <article class="prose">
      {
        groups.map((g) => (
          <section>
            <h2>{g.label}</h2>
            <table>
              <tbody>
                {g.rows.map((r) => (
                  <tr>
                    <td><a href={r.href}>{r.label}</a></td>
                    <td>{r.about}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        ))
      }
    </article>
  </div>
</Base>
