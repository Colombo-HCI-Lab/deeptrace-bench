---
// Every doc in nav order, with its description from the doc's front matter, and the guided pages
// that stand in for three of them.
import { getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { NAV, PAGES, href, leaves } from "../../lib/nav";

const base = import.meta.env.BASE_URL;
const PAGE_ABOUT: Record<string, string> = {
  timeline: "What each round of work did, and what comes next (progress.md laid out)",
  results: "What the runs show, with the numbers and their caveats (results.md laid out)",
  method: "The pipeline, the checks along it and the terms the site uses (method.md laid out)",
  coverage: "Every detector against every evalset: AUC, or the estimated GPU time",
  compute: "What each detector costs to run",
};
const groups = await Promise.all(
  NAV.map(async (g) => ({
    label: g.label,
    rows: await Promise.all(
      leaves(g.items).map(async (l) => ({
        label: l.label,
        href: href(l.id),
        about: PAGES.includes(l.id) ? PAGE_ABOUT[l.id] : ((await getEntry("docs", l.id))?.data.description ?? ""),
      })),
    ),
  })),
);
---

<Base title="Every doc · deeptrace-bench" description="Every page and doc, by group, with what each covers." current="docs">
  <div class="page">
    <header class="mast">
      <div class="kicker">Docs</div>
      <h1>Every doc</h1>
      <p class="lede">
        New here? Start with <a href={href("method")}>How it works</a>, then <a href={href("getting_started")}>Getting started</a>.
        The full write-ups behind the guided pages are <a href={`${base}docs/progress/`}>Progress</a>,
        <a href={`${base}docs/results/`}>Results</a> and <a href={`${base}docs/method/`}>How it works</a>.
      </p>
    </header>
    <article class="prose">
      {
        groups.map((g) => (
          <section>
            <h2>{g.label}</h2>
            <table>
              <tbody>
                {g.rows.map((r) => (
                  <tr>
                    <td><a href={r.href}>{r.label}</a></td>
                    <td>{r.about}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        ))
      }
    </article>
  </div>
</Base>
