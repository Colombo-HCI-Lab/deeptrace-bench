---
// The home page, the Timeline: progress.md laid out, and its only page. Where things stand comes
// first, then one line through time: open decisions and the plan ahead of today in grey, the
// rounds of work below it, newest first.
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { buildProgress } from "../lib/guide";

const base = import.meta.env.BASE_URL;
const P = buildProgress((await getEntry("docs", "progress"))!.body ?? "");
// The plan reads upward to today: the next step sits just above the line.
const ahead = P.next.slice().reverse();
---

<Base
  title="deeptrace-bench"
  description="Open deepfake detectors on South Asian audio and video under one evaluation setup: what each round of work did, and what comes next."
  current="timeline"
>
  <div class="stack">
    <header class="mast">
      <div class="kicker">Findings · as of {P.asOf}</div>
      <h1>What's done, and what's next</h1>
      <p class="lede">
        Where things stand, each round of work, newest first, and the plan. Numbers are on <a href={`${base}results/`}>Results</a>.
      </p>
    </header>
    <section id="where-things-stand" class="firstbox">
      <h2>Where things stand</h2>
      <div class="cols-2">
        {
          P.stand.map((b) => (
            <div class="item">
              <strong>{b.label}</strong>
              <div class="snip" set:html={b.body} />
            </div>
          ))
        }
      </div>
    </section>
    <section id="timeline">
      <header>
        <h2>Timeline</h2>
        <p>Open decisions and planned work in grey, then completed rounds newest first, with commit ranges.</p>
      </header>
      <div id="open-decisions-that-shape-the-results">
        {
          P.decisions.map((d) => (
            <article class="tl ahead decision">
              <span class="mark" aria-hidden="true" />
              <div class="when"><span>Open decision</span></div>
              <div>
                {d.code ? <code>{d.label}</code> : <h3>{d.label}</h3>}
                <div class="snip" set:html={d.body} />
              </div>
            </article>
          ))
        }
      </div>
      <div id="next">
        {
          ahead.map((n) => (
            <article class={`tl ahead${n.now ? " now" : ""}`}>
              <span class="mark" aria-hidden="true" />
              <div class="when">{n.now ? <span class="chip">Now</span> : <span>Planned</span>}</div>
              <div>
                <h3>{n.label}</h3>
                <div class="snip" set:html={n.body} />
              </div>
            </article>
          ))
        }
      </div>
      <div class="tl today">
        <span class="mark" aria-hidden="true" />
        <span>Today</span>
        <span>As of {P.asOf}</span>
      </div>
      {
        P.timeline.map((t) => (
          <article class="tl">
            <span class="mark" aria-hidden="true" />
            <div class="when">
              <time datetime={t.date}>{t.date}</time>
              {t.latest && <span class="tag">Latest</span>}
            </div>
            <div>
              <h3>{t.title}</h3>
              {t.commits && <div class="snip commits" set:html={t.commits} />}
              <div class="snip" set:html={t.body} />
            </div>
          </article>
        ))
      }
    </section>
  </div>
</Base>
