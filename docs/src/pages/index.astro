---
// The overview: the question, the short answer as one chart, where the work stands and the way
// into the rest of the site. Numbers come from status.json, the plan from progress.md.
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { buildOverview, buildProgress } from "../lib/guide";
import { LEGACY } from "../lib/links.mjs";
import { D } from "../lib/status";

const base = import.meta.env.BASE_URL;
const O = buildOverview(buildProgress((await getEntry("docs", "progress"))!.body ?? ""));
---

<Base
  title="deeptrace-bench"
  description="Do deepfake detectors work on South Asian speech and faces? Open detectors run on South Asian audio and video under one evaluation setup."
  section="overview"
>
  <header class="mast home">
    <div class="kicker">Colombo HCI Lab · Deepfake detection for South Asia · Phase 2</div>
    <h1>Do deepfake detectors work on South Asian speech and faces?</h1>
    <p class="lede">
      Published open detectors, trained mostly on English speech and Western faces, scored zero-shot on South Asian
      audio and video under one evaluation setup.
    </p>
    <div class="chips">
      <a class="chip" href={`${base}results/#read-this-first`}><span class="dot" aria-hidden="true"></span>Evaluation rules {D.eval_status}: numbers can still move</a>
      <span class="chip dim">Updated {D.built}</span>
    </div>
  </header>

  <section id="answer" class="block">
    <header>
      <div class="kicker">The short answer</div>
      <h2>It depends on what the detector learned from</h2>
      <p>
        AUC per detector on each open set: Urdu, two Bengali, IndicTTS (16 languages) and Hindi for audio; HiDF for
        faces. Left of the dashed line is below chance.
      </p>
    </header>
    <div class="chart">
      <div class="row colhead"><span>Detector</span><span>AUC on each set</span><span>Range</span></div>
      {
        O.tiers.map((t) => (
          <div class="tier">
            <div class="tierhead">
              <span class={t.badge}>{t.label}</span>
              <span>{t.title}</span>
            </div>
            {t.rows.map((r) => (
              <div class="row">
                <span class="name">{r.name}</span>
                <div class="strip">
                  {r.dots.map((d) => (
                    <span class="dot" title={d.title} style={`left: ${d.left}; background: ${d.bg}`} />
                  ))}
                </div>
                <span class="range">{r.range}</span>
              </div>
            ))}
          </div>
        ))
      }
      <div class="row axisrow">
        <span></span>
        <div class="axis"><span>0</span><span>0.5 coin flip</span><span>1 perfect</span></div>
        <span></span>
      </div>
    </div>
    <div class="cols-3">
      <a class="card" href={`${base}results/#audio-south-asian-speech`}>
        <span class="kicker">Audio</span>
        <strong>Multilingual pretraining helps</strong>
        <span>Same post-training data, different SSL pretraining: the MMS-300M AntiDeepfake model (about 1,400 languages) gets 15 to 45 times closer to AUC 1 than its wav2vec 2.0 small sibling.</span>
      </a>
      <a class="card" href={`${base}results/#audio-south-asian-speech`}>
        <span class="kicker">Audio</span>
        <strong>Language matters only for ASVspoof-trained detectors</strong>
        <span>Across 16 Indic languages, XLS-R + AASIST ranges from 0.49 to 0.86 AUC. MMS-300M stays at 0.996 or above in every one.</span>
      </a>
      <a class="card" href={`${base}results/#video-hidf`}>
        <span class="kicker">Faces</span>
        <strong>Even ranking, uneven false alarms</strong>
        <span>AUC barely moves by race, but at its global threshold GenD flags 28% of real Indian faces as fake, against 6 to 13% for other groups.</span>
      </a>
    </div>
    <a class="more" href={`${base}results/`}>All results and caveats →</a>
  </section>

  <section id="status" class="block">
    <header>
      <div class="kicker">As of {O.asOf}</div>
      <h2>Where the work stands</h2>
      <p>A detector counts once its adapter passes parity with the authors' code. Most unscored evalsets wait on access requests.</p>
    </header>
    <div class="cols-2">
      <div class="bars">
        <h3>Detectors</h3>
        {
          O.detectors.map((s) => (
            <div class="bar">
              <div class="top">
                <span><span>{s.label}</span><span>{s.note}</span></span>
                <b>{s.n}</b>
              </div>
              <div class="track"><div style={`width: ${s.w}`} /></div>
            </div>
          ))
        }
      </div>
      <div class="bars">
        <h3>Evalsets</h3>
        {
          O.evalsets.map((s) => (
            <div class="bar">
              <div class="top">
                <span><span>{s.label}</span><span>{s.note}</span></span>
                <b>{s.n}</b>
              </div>
              <div class="track"><div style={`width: ${s.w}`} /></div>
            </div>
          ))
        }
        <div class="foot">{O.runs} detector–evalset pairs scored in total.</div>
      </div>
    </div>
    <div class="cols-2">
      {
        O.latest && (
          <a class="card tint" href={`${base}progress/#timeline`}>
            <span class="kicker">Latest round · {O.latest.date}</span>
            <strong>{O.latest.title}</strong>
            <span class="more">Timeline →</span>
          </a>
        )
      }
      <a class="card tint" href={`${base}progress/#next`}>
        <span class="kicker">Up next</span>
        <ol>{O.next.map((x) => <li>{x.label}</li>)}</ol>
        <span class="more">The full plan →</span>
      </a>
    </div>
  </section>

</Base>

<script is:inline define:vars={{ base, legacy: LEGACY }}>
  // Links to the old single status page (#runs, #coverage ...) land where that section now lives.
  const to = legacy[location.hash.slice(1)];
  if (to) location.replace(base + to);
</script>
