---
// The old Models & data page: each of its tabs (#coverage, #models, #datasets, #compute) is a page
// of its own now.
import { INVENTORY } from "../lib/links.mjs";

const base = import.meta.env.BASE_URL;
const to = base + INVENTORY.coverage;
const map = Object.fromEntries(Object.entries(INVENTORY).map(([k, v]) => [k, base + v]));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Coverage · deeptrace-bench</title>
    <link rel="canonical" href={new URL(to, Astro.site).href} />
    <script is:inline define:vars={{ to, map }}>location.replace(map[location.hash.slice(1)] ?? to);</script>
    <noscript><meta http-equiv="refresh" content={`0; url=${to}`} /></noscript>
  </head>
  <body>
    <p>This page is now at <a href={to}>{to}</a>.</p>
  </body>
</html>
