---
// How a score is made: the pipeline and its checks, the terms the site uses and the repo's
// layout, all laid out from method.md (lib/guide.ts slices it by heading).
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { buildMethod } from "../lib/guide";
const base = import.meta.env.BASE_URL;
const repo = "https://github.com/Colombo-HCI-Lab/deeptrace-bench";
const M = buildMethod((await getEntry("docs", "method"))!.body ?? "");
// The checks sit under the step they guard: parity under set-up, the contamination guard under
// scoring, the publish guard under publishing.
const gateClass = ["g-parity", "g-guard", "g-pub"];
---

<Base
  title="How it works · deeptrace-bench"
  description="From a published detector to one trusted number: the pipeline, the checks along it, and the terms this site uses."
  section="method"
>
  <div class="stack">
    <header class="mast">
      <div class="kicker">How it works</div>
      <h1>From a published detector to one trusted number</h1>
      <p class="lede" set:html={M.lede} />
    </header>
    <nav class="index" aria-label="On this page">
      <ol>
        {M.plain && <li><a href="#plain-words">In plain words</a></li>}
        <li><a href="#pipeline">Pipeline</a></li>
        <li><a href="#key-terms">Key terms</a></li>
        <li><a href="#repo">The repo</a></li>
        <li><a href={`${base}docs/getting_started/`}>Getting started</a></li>
        <li><a href={`${base}docs/evaluation/`}>Evaluation in full</a></li>
      </ol>
    </nav>
    {
      M.plain && (
        <section id="plain-words" class="block">
          <header>
            <h2>In plain words</h2>
          </header>
          <div class="snip" style="max-width: 72ch" set:html={M.plain} />
        </section>
      )
    }
    <section id="pipeline" class="block">
      <header>
        <h2>The pipeline</h2>
        <p>One script per step.</p>
      </header>
      <div>
        <div class="flow">
          {
            M.steps.map((s) => (
              <div class="stage">
                <div class="kicker">{s.kicker}</div>
                <h3>{s.title}</h3>
                <p set:html={s.body} />
                <p style="color: var(--muted)">Writes: <span set:html={s.writes} /></p>
              </div>
            ))
          }
        </div>
        <div class="gates">
          {
            M.checks.map((c, i) => (
              <div class={`gate ${gateClass[i] ?? ""}`}>
                <strong>{c.title}</strong>
                <span set:html={c.body} />
              </div>
            ))
          }
        </div>
      </div>
      <dl class="terms-dl" style="margin-top: 8px">
        {
          M.scripts.map((s) => (
            <div>
              <dt set:html={s.name} />
              <dd set:html={s.body} />
            </div>
          ))
        }
      </dl>
    </section>
    <section id="key-terms" class="block">
      <header>
        <h2>Key terms</h2>
      </header>
      <div class="terms">
        {
          M.terms.map((g) => (
            <dl>
              <div>{g.title}</div>
              {g.rows.map((t) => (
                <div>
                  <dt>{t.term}</dt>
                  <dd set:html={t.body} />
                </div>
              ))}
            </dl>
          ))
        }
      </div>
    </section>
    <section id="repo" class="block">
      <header>
        <h2>The repo at a glance</h2>
        <p>Where each part of the pipeline lives in <a href={repo} target="_blank" rel="noopener">Colombo-HCI-Lab/deeptrace-bench</a>.</p>
      </header>
      <div class="cards small">
        {
          M.repo.map((r) =>
            r.path ? (
              <a class="card repo" href={`${repo}/tree/main/${r.path}`} target="_blank" rel="noopener">
                <code>{r.label}</code>
                <span set:html={r.body} />
              </a>
            ) : (
              <div class="card repo">
                <code>{r.label}</code>
                <span set:html={r.body} />
              </div>
            ),
          )
        }
      </div>
      <div class="links">
        <a href={`${base}docs/getting_started/`}>Getting started →</a>
        <a href={`${base}docs/adding_a_model/`}>Adding a model →</a>
        <a href={`${base}docs/adding_a_dataset/`}>Adding a dataset →</a>
        <a href={`${base}docs/spark/`}>Where to run →</a>
      </div>
    </section>
  </div>
</Base>
