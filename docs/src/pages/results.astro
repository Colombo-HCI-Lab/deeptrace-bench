---
// What the runs show: results.md laid out as tables and charts, joined with every run in
// status.json. This is results.md's only page: sections without a layout of their own show as
// prose (R.more).
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { panels } from "../lib/figures";
import { buildResults } from "../lib/guide";

const R = buildResults((await getEntry("docs", "results"))!.body ?? "");
// The page's sections, in the bar above them.
const sections = [
  { href: "#reading-the-numbers", text: "Reading AUC" },
  { href: "#experiments", text: "Experiments" },
  { href: "#the-datasets", text: "Datasets" },
  { href: "#at-a-glance", text: "Every detector, every dataset" },
  { href: "#insights", text: "Insights" },
  { href: "#audio-south-asian-speech", text: "Detail: speech" },
  { href: "#reproductions", text: "Reproductions" },
  { href: "#video-hidf", text: "Faces" },
  ...R.more.map((m) => ({ href: `#${m.id}`, text: m.short })),
  { href: "#all-runs", text: "All runs" },
  { href: "#what-the-results-cant-say-yet", text: "Not covered yet" },
];
---

<Base
  title="Results · deeptrace-bench"
  description="What the runs so far show: open deepfake detectors on South Asian speech and faces, with the numbers and their caveats."
  current="results"
>
  <div class="stack">
    <header class="mast">
      <div class="kicker">Findings</div>
      <h1>What the runs show</h1>
      <p class="lede">Zero-shot throughout: released weights, no retraining. AUC unless noted.</p>
      <div class="scale" aria-label="Colour scale">
        <div class="track"></div>
        <div class="ticks"><span>0 backwards</span><span>0.5 coin flip</span><span>1 perfect</span></div>
      </div>
    </header>

    <section id="read-this-first" class="firstbox">
      <h2>Read this first</h2>
      <div class="cols-2">
        {
          R.first.map((b) => (
            <div class="item">
              <strong>{b.label}</strong>
              <div class="snip" set:html={b.body} />
            </div>
          ))
        }
      </div>
    </section>

    <nav class="index" aria-label="On this page">
      <ol>{sections.map((x) => <li><a href={x.href}>{x.text}</a></li>)}</ol>
    </nav>

    <section id="reading-the-numbers" class="block">
      <header>
        <div class="kicker">Primer</div>
        <h2>Reading AUC and EER</h2>
        <p>A detector gives every clip a fake score from 0 to 1. AUC is the chance that a random fake scores above a random real clip. EER is the error rate at the threshold where false alarms and missed fakes are equal.</p>
      </header>
      <figure class="fig" style="margin: 0; max-width: none">
        <div class="frame">
          <div class="panels">
            {
              panels.map((p) => (
                <div>
                  <div class="head"><span style={`background: ${p.bg}; color: ${p.fg}`}>AUC {p.auc}</span><span>EER {p.eer}</span></div>
                  <div class="hist" aria-hidden="true">
                    <div class="bars">
                      {p.bars.map((b) => <span><span style={`height: ${b.r}; background: ${b.rbg}`} /><span /><span style={`height: ${b.f}; background: ${b.fbg}`} /></span>)}
                      <span class="axis0" />
                      <span class="thr" style={`left: ${p.thr}`} />
                    </div>
                    <div class="ends"><span>0</span><span>fake score</span><span>1</span></div>
                  </div>
                  <div class="note2"><strong>{p.label}.</strong> {p.note}</div>
                </div>
              ))
            }
          </div>
          <div class="swatches">
            <span><i style="background: var(--real)"></i>Real clips, above the axis</span>
            <span><i style="background: var(--fake)"></i>Fake clips, below</span>
            <span><i style="background: var(--muted)"></i><i style="margin-left: -6px; background: var(--bad)"></i>Wrong side of the threshold: false alarms and missed fakes</span>
            <span><i style="width: 0; height: 14px; border-left: 1.5px dashed var(--ink)"></i>Threshold at the EER point</span>
          </div>
        </div>
        <figcaption><strong>Four detectors, four AUCs.</strong> The more the two piles overlap, the closer AUC falls to 0.5 and the more clips land on the wrong side of any threshold. Illustrative distributions; each badge uses the colour scale of the tables below.</figcaption>
      </figure>
    </section>

    <section id="experiments" class="block">
      <header>
        <div class="kicker">The questions</div>
        <h2>Experiments</h2>
        <div class="snip" style="max-width: 66ch; color: var(--muted)" set:html={R.experiments.intro} />
      </header>
      <div class="exps">
        {
          R.experiments.cards.map((e) => (
            <div class={`exp ${e.kind}`}>
              <div class="top"><span>{e.id}</span><span>{e.chip}</span></div>
              <strong>{e.title}</strong>
              <span class="q">{e.q}</span>
              <span class="st">{e.status}</span>
            </div>
          ))
        }
      </div>
      <div class="snip prose text" set:html={R.experiments.after} />
    </section>

    <section id="the-datasets" class="block">
      <header>
        <div class="kicker">1 · What they were tested on</div>
        <h2>The datasets</h2>
      </header>
      <div class="scroll">
        <table class="tbl dsets">
          <thead>
            <tr>{R.datasets.head.map((h, i) => <th class={i === 4 ? "num" : undefined}>{h}</th>)}</tr>
          </thead>
          <tbody>
            {
              R.datasets.rows.map((r) => (
                <tr>
                  {r.map((c, i) => (
                    <td class={i === 0 ? "name" : i === 4 ? "num" : undefined}>{c}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="snip text muted" set:html={R.datasets.note} />
    </section>

    <section id="at-a-glance" class="block">
      <header>
        <div class="kicker">2 · The results</div>
        <h2>Every detector on every dataset</h2>
        <p>AUC: 0.5 is a coin flip, 1 is perfect, below 0.5 means the detector has real and fake backwards. Speech detectors are grouped by what they were trained on, face detectors by what they look at. Each column is a full evalset; the quick subsets are in <a href="#all-runs">All runs</a>. Hover a cell for its interval and clip count.</p>
      </header>
      <div class="toggle" role="group" aria-label="Metric">
        <button type="button" data-metric="auc" aria-pressed="true">AUC · higher is better</button>
        <button type="button" data-metric="eer" aria-pressed="false">EER · lower is better</button>
      </div>
      {
        R.grids.map((grid) => (
          <Fragment>
            <h3 class="sub" id={`grid-${grid.id}`}>{grid.title}</h3>
            <div class="scroll">
              <table class="heat grid">
                <thead>
                  <tr class="cg">
                    <th></th>
                    {grid.colGroups.map((g) => <th colspan={g.span}>{g.label}</th>)}
                  </tr>
                  <tr>
                    <th>Detector</th>
                    {grid.cols.map((c) => <th><span>{c.name}</span><span>{c.sub}</span></th>)}
                  </tr>
                </thead>
                <tbody>
                  {grid.groups.map((g) => (
                    <Fragment>
                      <tr class="tierrow">
                        <td colspan={grid.span}>
                          <div class="tierhead"><span class={g.badge}>{g.label}</span><span>{g.title}</span></div>
                        </td>
                      </tr>
                      {g.rows.map((m) => (
                        <tr>
                          <th scope="row">
                            <span class="dname">{m.name}</span>
                            {m.type && <span class="dtype">{m.type}</span>}
                            <span class="dtype">Backbone: {m.built}</span>
                            <span class="dtype">Trained on: {m.trained}</span>
                            {m.noParity && <span class="dtype dflag">No parity check yet, so not a result</span>}
                          </th>
                          {m.cells.map((c) => (
                            <td class={`g-${c.kind}${c.home ? " home" : ""}`} title={c.title} style={c.style}>
                              {c.eer ? <Fragment><span class="auc">{c.text}</span><span class="eer">{c.eer}</span></Fragment> : c.text}
                              {c.overlap && <sup>so</sup>}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </Fragment>
                  ))}
                </tbody>
              </table>
            </div>
          </Fragment>
        ))
      }
      <ul class="gridkey">
        <li><span class="sw g-trained"></span>trained on it, so not scored</li>
        <li><span class="sw home"></span>scored on the held-out part of its own training set</li>
        <li><sup>so</sup> source overlap: the detector's pretraining shares a corpus with this set</li>
        <li><span class="sw g-na">–</span>it can't read this set</li>
        <li><span class="sw g-todo">·</span>not run yet</li>
      </ul>
    </section>

    <section id="insights" class="block">
      <header>
        <div class="kicker">3 · What it shows</div>
        <h2>Insights</h2>
        <p>Each point names the cells in the grid above that support it.</p>
      </header>
      <ol class="insights">
        {
          R.insights.map((it) => (
            <li>
              <span class="n">{it.n}</span>
              <div>
                <strong>{it.label}</strong>
                <div class="snip" set:html={it.body} />
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="audio-south-asian-speech" class="block">
      <header>
        <div class="kicker">Detail · audio</div>
        <h2>South Asian speech, in more depth</h2>
        <p>The breakdowns behind insights 3 and 7, and what else the per-group numbers show.</p>
      </header>
      <h3 class="sub" style="margin-top: 0">{R.lang.title}</h3>
      <div class="snip text muted" set:html={R.lang.intro} />
      <div class="scroll">
        <table class="heat lang">
          <thead>
            <tr>
              <th>{R.lang.first}</th>
              {R.lang.cols.map((c) => <th style="width: 16%"><span>{c.name}</span><span>{c.range}</span></th>)}
            </tr>
          </thead>
          <tbody>
            {
              R.lang.rows.map((r) => (
                <tr>
                  <th scope="row">{r.name}</th>
                  {r.cells.map((c) => (
                    <td title={c.title} style={`background: ${c.bg}; color: ${c.fg}`}>
                      {c.text}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="snip text" set:html={R.lang.after} />

      <div class="cols-2" style="margin-top: 12px">
        <div class="card">
          <h3>{R.pre.title}</h3>
          <div class="scroll">
            <table class="heat pre">
              <thead>
                <tr><th>{R.pre.first}</th>{R.pre.cols.map((c) => <th>{c.name}</th>)}</tr>
              </thead>
              <tbody>
                {
                  R.pre.rows.map((r) => (
                    <tr>
                      <th scope="row">{r.name}</th>
                      {r.cells.map((c) => <td style={`background: ${c.bg}; color: ${c.fg}`}>{c.text}</td>)}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <div class="snip" style="font-size: 0.9rem" set:html={R.pre.body} />
        </div>
        <div class="stack" style="gap: 16px; align-content: start">
          {
            R.notes.map((n) => (
              <div class="card" style="font-size: 0.9rem">
                <h3>{n.title}</h3>
                <div class="snip" set:html={n.body} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="reproductions" class="block">
      <header>
        <div class="kicker">Sanity check</div>
        <h2>Reproductions: do our numbers match the papers?</h2>
        <p>Each detector on its own paper's test set. Difference in EER percentage points; positive means we measure more errors.</p>
      </header>
      <div class="scroll">
        <table class="tbl repro">
          <thead>
            <tr>
              <th>Detector</th><th>Evalset</th><th class="num">Our EER (95% interval)</th><th>Published</th><th
                class="num">Difference</th
              ><th class="num">AUC</th>
            </tr>
          </thead>
          <tbody>
            {
              R.repro.map((r) => (
                <tr>
                  <td class="nowrap">{r.model}</td>
                  <td class="nowrap">{r.evalset}</td>
                  <td class="num">{r.eer}</td>
                  <td class="dim">{r.published}</td>
                  <td class="num diff">{r.diff}</td>
                  <td class="num">{r.auc}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="snip text" set:html={R.reproBody} />
    </section>

    <section id="video-hidf" class="block">
      <header>
        <div class="kicker">Video · provisional</div>
        <h2>Faces: HiDF</h2>
        <div class="snip" style="max-width: 66ch; color: var(--muted)" set:html={R.video.intro} />
      </header>
      <div class="cirows">
        {
          R.video.rows.map((v) => (
            <div class="row">
              <span>{v.name}</span>
              <div class="ci">
                <span class="bar" aria-hidden="true" style={`left: ${v.ciLeft}; width: ${v.ciWidth}`} />
                <span class="dot" style={`left: ${v.left}; background: ${v.dot}`} />
              </div>
              <span class="val"><b>{v.auc}</b> <span class="dim">({v.ci}) · EER {v.eer}</span></span>
            </div>
          ))
        }
        <div class="row axisrow">
          <span></span>
          <div class="axis"><span>0.5</span><span>0.75</span><span>1.0 AUC</span></div>
          <span></span>
        </div>
      </div>
      <div class="snip text" set:html={R.video.raceIntro} />
      <div class="scroll">
        <table class="tbl race">
          <thead>
            <tr>{R.video.race.head.map((h) => <th>{h}</th>)}</tr>
          </thead>
          <tbody>
            {R.video.race.rows.map((r) => <tr>{r.map((c) => <td class={c.hot ? "hot" : undefined}>{c.text}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
      <div class="cols-3">
        {
          R.video.points.map((p) => (
            <div class="card" style="font-size: 0.9rem">
              <strong style="font-size: 1rem">{p.label}</strong>
              <div class="snip" set:html={p.body} />
            </div>
          ))
        }
      </div>
    </section>

    {
      R.more.map((m) => (
        <section id={m.id} class="block">
          <header>
            <div class="kicker">Write-up</div>
            <h2>{m.title}</h2>
          </header>
          <div class="prose" set:html={m.body} />
        </section>
      ))
    }

    <section id="all-runs" class="block">
      <header>
        <div class="kicker">Every countable run</div>
        <h2>All runs</h2>
        <p>One row per detector and evalset scored in full. Failed clips (e.g. no face found) are counted, not dropped. Wall time includes I/O.</p>
      </header>
      <div class="filters" role="group" aria-label="Filter runs">
        {
          R.runs.filters.map((f) => (
            <button type="button" data-filter={f.id} aria-pressed={String(f.id === "all")}>
              {f.label} · {f.n}
            </button>
          ))
        }
      </div>
      <div class="scroll">
        <table class="tbl runs">
          <thead>
            <tr>
              <th>Evalset</th><th>Detector</th><th class="num">AUC</th><th class="num">95% interval</th><th
                class="num">EER</th
              ><th class="num">Real / fake</th><th class="num">Failed</th><th class="num">Wall time</th><th>Caveats</th>
            </tr>
          </thead>
          <tbody>
            {
              R.runs.rows.map((r) => (
                <tr title={r.title} data-group={r.group}>
                  <td>
                    <span class="nowrap">{r.evalset}</span>
                    <span class="id">{r.evalsetId}</span>
                  </td>
                  <td class="nowrap">{r.model}</td>
                  <td class="auc">
                    <span class="auc-pill" style={`background: ${r.bg}; color: ${r.fg}`}>{r.auc}</span>
                  </td>
                  <td class="num dim">{r.ci}</td>
                  <td class="num">{r.eer}</td>
                  <td class="num">{r.realFake}</td>
                  <td class="num">{r.failed}</td>
                  <td class="num">{r.wall}</td>
                  <td>
                    <div class="flaglist">{r.flags.map((f) => <span class="flagtag">{f}</span>)}</div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <dl class="terms-dl">
        <div><dt>below chance</dt><dd>AUC under 0.5: a score-reading bug on a reproduction set, a real finding on a South Asian one.</dd></div>
        <div><dt>source overlap</dt><dd>Pretraining used a corpus the evalset draws on. Kept out of headline numbers.</dd></div>
        <div><dt>no parity check</dt><dd>Adapter not yet matched against the authors' code. Provisional.</dd></div>
        <div><dt>score direction unchecked</dt><dd>No above-chance reproduction run yet, so the score's sign is unconfirmed.</dd></div>
      </dl>
    </section>

    <section id="what-the-results-cant-say-yet" class="block" style="gap: 16px">
      <header>
        <div class="kicker">Not covered yet</div>
        <h2>What the results can't say yet</h2>
      </header>
      <div class="snip" style="max-width: 72ch" set:html={R.gaps} />
    </section>
  </div>
</Base>

<script>
  // AUC or EER in the grid. Both are in the page; this only switches.
  const glance = document.getElementById("at-a-glance")!;
  for (const b of glance.querySelectorAll<HTMLButtonElement>(".toggle button")) {
    b.addEventListener("click", () => {
      glance.dataset.metric = b.dataset.metric;
      for (const o of glance.querySelectorAll(".toggle button")) o.setAttribute("aria-pressed", String(o === b));
    });
  }

  // Which runs the table at the bottom shows. Every row is in the page; this only switches.
  const runs = document.getElementById("all-runs")!;
  for (const b of runs.querySelectorAll<HTMLButtonElement>(".filters button")) {
    b.addEventListener("click", () => {
      const f = b.dataset.filter;
      for (const o of runs.querySelectorAll(".filters button")) o.setAttribute("aria-pressed", String(o === b));
      for (const tr of runs.querySelectorAll<HTMLTableRowElement>("tbody tr")) tr.hidden = f !== "all" && tr.dataset.group !== f;
    });
  }
</script>
